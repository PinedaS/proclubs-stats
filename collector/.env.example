# Copia este archivo a .env (está en .gitignore) y completa los valores.

# Supabase: Project Settings -> API. La service_role SOLO va aquí, nunca en el dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Club a seguir. Se busca por nombre exacto (el ID cambia cada temporada).
# Club de prueba ajeno, mientras el nuestro ("FC Aston Huila") no tenga partidos:
EA_CLUB_NAME=Aston Huila
# Producción:
# EA_CLUB_NAME=FC Aston Huila
SEASON=FC27

# Opcionales
# EA_PLATFORM=common-gen5
# EA_MATCH_TYPES=leagueMatch,playoffMatch,friendlyMatch
# COLLECTOR_RUNNER=local
