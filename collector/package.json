{
  "name": "proclubs-stats-collector",
  "version": "0.1.0",
  "private": true,
  "description": "Colector de partidos de Clubes (EA FC) hacia Supabase",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "collect": "node --env-file-if-exists=.env src/main.ts",
    "fetch-fixture": "node --env-file-if-exists=.env scripts/fetch-fixture.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:integration": "bash test/integration/run.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "proclubs-sdk": "0.3.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
